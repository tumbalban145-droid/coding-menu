--==================================================
-- ADD BUTTON
--==================================================

local function AddButton(Page, text, callback, isToggle)
	local Button = Instance.new("TextButton")
	Button.Size = UDim2.new(1, -5, 0, 45)
	Button.BackgroundColor3 = Color3.fromRGB(32, 32, 43)
	Button.BorderSizePixel = 0
	Button.Text = text
	Button.TextColor3 = Color3.fromRGB(235, 235, 240)
	Button.TextSize = 13
	Button.Font = Enum.Font.GothamSemibold
	Button.AutoButtonColor = false
	Button.ZIndex = 4
	Button.Parent = Page
	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 8)
	Corner.Parent = Button
	local Enabled = false
	Button:SetAttribute("Enabled", false)
	Button.MouseEnter:Connect(function()
		if Enabled then return end
		TweenService:Create(Button, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(48, 48, 62)}):Play()
	end)
	Button.MouseLeave:Connect(function()
		if Enabled then return end
		TweenService:Create(Button, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(32, 32, 43)}):Play()
	end)
	Button.MouseButton1Click:Connect(function()
		if isToggle then
			Enabled = not Enabled
			Button:SetAttribute("Enabled", Enabled)
			if Enabled then
				TweenService:Create(Button, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(40, 150, 75)}):Play()
				Button.Text = text.. " [ON]"
			else
				TweenService:Create(Button, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(32, 32, 43)}):Play()
				Button.Text = text
			end
			if callback then callback(Button, Enabled) end
		else
			if callback then callback(Button) end
		end
	end)
	return Button
end

--==================================================
-- AUTO MISI RARITY FUNCTION
--==================================================
getgenv().StopBot = true -- default mati

local function AutoMisiRarity()
	local char = player.Character or player.CharacterAdded:Wait()
	local hrp = char:WaitForChild("HumanoidRootPart")
	local humanoid = char:WaitForChild("Humanoid")

	-- 1. TEMPAT TRIAL INTERACT
	local TRIAL = CFrame.new(-93.2920837, 57.4325294, -10203.1035)
	local TEMPAT_TRIAL = workspace:FindFirstChild("Tower Trial") -- GANTI KALO NAMA PART NYA BEDA

	-- 2. LOKASI TIAP RARITY
	local LOKASI_BARANG = {
		Common = CFrame.new(-93.2106934, 55.2619057, -134.602539),
		Uncommon = CFrame.new(-93.2106934, 55.2619057, -284.602539),
		Rare = CFrame.new(-93.2106934, 55.2619057, -482.602539),
		Epic = CFrame.new(-93.2106934, 55.2619057, -776.602539),
		Legendary = CFrame.new(-93.2106934, 55.2619057, -1262.60254),
		Mythic = CFrame.new(-93.2106934, 55.2619057, -1946.60254),
		Cosmic = CFrame.new(-93.2106934, 55.2619057, -2873.60254),
		Secret = CFrame.new(-93.2106934, 55.2619057, -7851.60254)
	}

	local function terbangKe(targetCFrame)
		humanoid.WalkSpeed = 0
		local tinggi = 250
		local jarak = (hrp.Position - targetCFrame.Position).Magnitude
		local waktu = math.clamp(jarak / 400, 1.5, 12)
		local mid1 = CFrame.new(hrp.Position.X, hrp.Position.Y + tinggi, hrp.Position.Z)
		local mid2 = CFrame.new(targetCFrame.X, targetCFrame.Y + tinggi, targetCFrame.Z)
		TweenService:Create(hrp, TweenInfo.new(1), {CFrame = mid1}):Play().Completed:Wait()
		TweenService:Create(hrp, TweenInfo.new(waktu), {CFrame = mid2}):Play().Completed:Wait()
		TweenService:Create(hrp, TweenInfo.new(1), {CFrame = targetCFrame}):Play().Completed:Wait()
		humanoid.WalkSpeed = 16
		task.wait(0.3)
	end
	
	local function jalanKe(targetPart)
		if not targetPart then return end
		humanoid:MoveTo(targetPart.Position + Vector3.new(0,3,0))
		humanoid.MoveToFinished:Wait()
		task.wait(0.2)
	end

	local function bacaRarityMisi()
		local gui = player.PlayerGui:FindFirstChild("MisiGUI") -- GANTI NAMA GUI MISI LU
		if not gui then return nil end
		local label = gui:FindFirstChild("TextLabel", true)
		if not label then return nil end
		local text = string.lower(label.Text)
		print("Misi: "..text)
		if string.find(text, "common") and not string.find(text, "uncommon") then return "Common" end
		if string.find(text, "uncommon") then return "Uncommon" end
		if string.find(text, "rare") then return "Rare" end
		if string.find(text, "epic") then return "Epic" end
		if string.find(text, "legendary") then return "Legendary" end
		if string.find(text, "mythic") then return "Mythic" end
		if string.find(text, "cosmic") then return "Cosmic" end
		if string.find(text, "secret") then return "Secret" end
		return nil
	end

	local function autoHold(part, holdTime)
		if not part then return end
		local prompt = part:FindFirstChildOfClass("ProximityPrompt")
		if prompt then fireproximityprompt(prompt, holdTime) task.wait(holdTime + 0.3) end
	end

	local function cariBarang(rarity)
		for _, v in pairs(workspace:GetChildren()) do
			if v.Name == rarity.."Item" and (v.Position - hrp.Position).Magnitude < 30 then -- GANTI NAMA BARANG
				return v
			end
		end
	end

	-- LOOP
	while not getgenv().StopBot do
	terbangKe(TRIAL)
		task.wait(0.5)
		jalanKe(TEMPAT_TRIAL)
		autoHold(TEMPAT_TRIAL, 0.5)
		
		task.wait(1)
		local rarity = bacaRarityMisi()
		
		if rarity then
			local lokasi = LOKASI_BARANG[rarity]
			if lokasi then
				terbangKe(lokasi)
				task.wait(0.3)
				local barang = cariBarang(rarity)
				if barang then jalanKe(barang) autoHold(barang, 2) end -- GANTI 2 = DURASI HOLD
				
				terbangKe(TRIAL)
				task.wait(0.5)
				jalanKe(TEMPAT_TRIAL)
				autoHold(TEMPAT_TRIAL, 0.5)
				task.wait(4)
			end
		else
			task.wait(3)
		end
	end
end

