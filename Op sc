--==================================================
-- TAB SELECTOR
--==================================================

local function SelectTab(tabName, pageName)
	for name, button in pairs(Tabs) do button:SetAttribute("Selected", false) TweenService:Create(button, TweenInfo.new(0.15), {BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(160, 160, 175)}):Play() end
	for name, page in pairs(Pages) do page.Visible = false end
	local SelectedButton = Tabs[tabName]
	SelectedButton:SetAttribute("Selected", true)
	TweenService:Create(SelectedButton, TweenInfo.new(0.15), {BackgroundTransparency = 0, BackgroundColor3 = Color3.fromRGB(45, 45, 60), TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
	Pages[pageName].Visible = true
end

