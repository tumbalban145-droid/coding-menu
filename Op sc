-- FUNGSI AUTO MISI
local function getChar()
    local char = player.Character or player.CharacterAdded:Wait()
    return char, char:WaitForChild("HumanoidRootPart"), char:WaitForChild("Humanoid")
end

local function terbangKe(cf)
    local _, hrp = getChar()
    hrp.CFrame = cf
end

local function jalanKe(targetPart)
    local _, humanoid = getChar()
    if not targetPart then return end
    humanoid:MoveTo(targetPart.Position + Vector3.new(0,3,0))
    humanoid.MoveToFinished:Wait()
    task.wait(0.2)
end

local function bacaRarityMisi()
    local guimisi = player.PlayerGui:FindFirstChild("MisiGUI")
    if not guimisi then return nil end
    local label = guimisi:FindFirstChild("TextLabel", true)
    if not label then return nil end
    local text = string.lower(label.Text)
    for rarity,_ in pairs(LOKASI_BARANG) do
        if string.find(text, string.lower(rarity)) then return rarity end
    end
    return nil
end

local function autoHold(part, holdTime)
    if not part then return end
    local prompt = part:FindFirstChildOfClass("ProximityPrompt")
    if prompt then fireproximityprompt(prompt, holdTime) end
end

local function cariBarang(rarity)
    local _, hrp = getChar()
    for _, v in pairs(workspace:GetChildren()) do
        if v.Name == rarity.."Item" and (v.Position - hrp.Position).Magnitude < 250 then
            return v
        end
    end
end

