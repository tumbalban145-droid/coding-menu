local function switchPage(page)
    local isHome = page == "Home"

    home.Visible = isHome
    main.Visible = not isHome

    homeBtn.BackgroundColor3 = isHome and C.button or C.panel
    homeBtn.TextColor3 = isHome and C.white or C.muted

    mainBtn.BackgroundColor3 = isHome and C.panel or C.button
    mainBtn.TextColor3 = isHome and C.muted or C.white

    tween(selectedBar, {
        Position = UDim2.fromOffset(9, isHome and 49 or 96)
    }, 0.2)
end

