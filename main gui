local function makeFunction(name, description, y, callback)
    local card = create("Frame", {
        Position = UDim2.fromOffset(20, y),
        Size = UDim2.new(1, -40, 0, 48),
        BackgroundColor3 = C.card,
        BorderSizePixel = 0,
    }, main)
    corner(card, 9)
    outline(card, C.blue, 1, 0.72)

    local btn = create("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
    }, card)

    label(card, "✦  " .. name,
        UDim2.fromOffset(12, 6),
        UDim2.new(1, -45, 0, 18), 11, C.white, Enum.Font.GothamBold)

    label(card, description,
        UDim2.fromOffset(13, 25),
        UDim2.new(1, -48, 0, 15), 9, C.muted)

    label(card, "›",
        UDim2.new(1, -30, 0, 5),
        UDim2.fromOffset(20, 35), 23, C.purple, Enum.Font.GothamBold)

    btn.MouseEnter:Connect(function()
        tween(card, {BackgroundColor3 = C.button})
    end)

    btn.MouseLeave:Connect(function()
        tween(card, {BackgroundColor3 = C.card})
    end)

    btn.Activated:Connect(callback)
    return btn
end

