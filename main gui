local function create(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end

local function corner(obj, radius)
    create("UICorner", {
        CornerRadius = UDim.new(0, radius)
    }, obj)
end

local function outline(obj, color, thickness, transparency)
    return create("UIStroke", {
        Color = color,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
    }, obj)
end

local function label(parent, text, pos, size, fontSize, color, font)
    return create("TextLabel", {
        Position = pos,
        Size = size,
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = color or C.white,
        TextSize = fontSize or 12,
        Font = font or Enum.Font.Gotham,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, parent)
end

local function tween(obj, properties, duration)
    TweenService:Create(
        obj,
        TweenInfo.new(duration or 0.18, Enum.EasingStyle.Quart,
            Enum.EasingDirection.Out),
        properties
    ):Play()
end

